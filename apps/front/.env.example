# Copy to .env. All of these are optional; the defaults assume the API is on the
# same host as the page.

# API scheme, host and port. VITE_API_PORT is accepted with or without a leading
# colon. Together these form the REST base URL and the socket.io origin.
VITE_API_PROTOCOL=http
VITE_API_PORT=3000

# Best left unset. When it is absent the API host is taken from the page's own
# hostname, so browsing kune.local, www.kune.local, localhost or the LAN IP all
# reach the API on that same host. That matters beyond convenience: session
# cookies are SameSite=Lax, so a page on www.kune.local calling an API on
# localhost gets through CORS and then silently fails to stay logged in.
# Set it only when the API genuinely lives on another host.
# VITE_API_URL=kune.local

# Origin the buzzer QR code sends players to. Defaults to the current origin,
# which is right unless the app is reachable at a different address than the one
# the host is browsing.
# VITE_BUZZER_ORIGIN=http://kune.local:5173
