{
  "name": "back",
  "version": "0.3.0",
  "private": true,
  "description": "KuneLab Web Games API",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx src/smoke-run.ts",
    "smoke": "tsx src/smoke-run.ts",
    "admin": "tsx src/cli/admin.ts",
    "mafia:sim": "tsx src/mafia/simulate.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/session": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.3",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3",
    "game-core": "workspace:*",
    "coronaz-core": "workspace:*",
    "chat-core": "workspace:*",
    "i18n": "workspace:*",
    "mafia-core": "workspace:*",
    "@anthropic-ai/sdk": "^0.110.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "bcrypt@6.0.0": true,
    "better-sqlite3@13.0.3": true
  }
}
