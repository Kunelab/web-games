# Copy to .env and fill in. Validated at startup by src/env.ts, which exits with
# a readable message rather than failing later on an undefined value.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Signs the session cookie. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=

# Set to false once your accounts exist to stop anyone creating new ones.
# Existing logins keep working. Anything other than "false" leaves it open.
REGISTRATION_OPEN=true

# A relative path is resolved against apps/back, not the working directory, so
# this is the same file whether you run pnpm dev from here or from the repo root.
DATABASE_FILE=./kune.db

# Set to true for SQL query logging and debug-level request logs.
DEBUG=false

# Returns the password-reset link in the HTTP response instead of only writing
# it to the log. There is no SMTP path yet, so this is how the reset flow is
# tested without reading every link out of the server log.
#
# DEVELOPMENT ONLY. With this on, anyone who can name an account's e-mail
# address is handed a working link to take that account over. Leave it unset on
# anything reachable; the server warns at every boot while it is on.
PASSWORD_RESET_ECHO=false

# Used for the CORS allow-list and the socket.io origin check. The `www.` variant
# of FRONT_URL is allowed automatically, as are localhost and 127.0.0.1 whenever
# NODE_ENV is not production.
FRONT_PROTOCOL=http
FRONT_URL=kune.local
# With or without the leading colon, both are accepted.
FRONT_PORT=5173

# Any further origins the frontend is reachable at, comma separated. A browser
# treats each hostname as a distinct origin, so the LAN IP needs listing here if
# you use it.
# FRONT_ORIGINS=http://192.168.1.18:5173,https://games.example.com

# Optional: serve the built frontend from this API process. Resolved as
# apps/<FRONT_DIR>/<FRONT_DIR_BUILD>. Leave unset in dev, where Vite serves the
# frontend itself.
FRONT_DIR=front
FRONT_DIR_BUILD=dist

# Required by the YouTube endpoints: POST /api/media/youtube/lookup, which
# prefills a blind test from a link, and POST /api/media/youtube/import, which
# turns a YouTube playlist into draft blind tests. Everything else works without it.
GOOGLE_API_KEY=
