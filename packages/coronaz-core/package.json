{
  "name": "coronaz-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CoronaZ rules: map generation, combat, enemy AI and the realtime protocol. Pure and seeded, imported by both apps.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "sim": "tsx src/sim/cli.ts",
    "district": "tsx src/sim/district.ts",
    "lint": "eslint .",
    "why": "tsx src/sim/why.ts"
  },
  "dependencies": {
    "presence-core": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
